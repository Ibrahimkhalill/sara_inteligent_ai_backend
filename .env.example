# Copy this file to .env and fill in the values.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# Comma-separated, e.g. https://example.com,https://api.example.com
CSRF_TRUSTED_ORIGINS=

# Email (Gmail SMTP - use an App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# OpenAI (chatbot)
OPENAI_API_KEY=sk-...

# Stripe (payment)
STRIPE_API_KEY=sk_test_...
ENDPOINT_SECRET=whsec_...

# Firebase (push notifications) - optional, path to service account JSON
FIREBASE_CREDENTIALS_PATH=

# Google Sign-In - comma-separated OAuth client IDs (web, Android, iOS)
GOOGLE_CLIENT_IDS=

# Frontend base URL for Stripe checkout success/cancel redirects
FRONTEND_URL=http://127.0.0.1:3901

# Comma-separated allowed frontend origins - required for cookie login (empty = allow all, no cookies)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3901,http://localhost:3901

# Set to False on extra web workers so reminders run in one process only
ENABLE_SCHEDULER=True

# Gemini (chatbot) - used instead of OpenAI when set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Auth cookies (web app). Secure defaults to True when DJANGO_DEBUG=False.
# If frontend and API are on different domains use AUTH_COOKIE_SAMESITE=None (needs HTTPS).
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
